# Stub for `cuda.bindings.nvml` (cuda-bindings 13.x, no types shipped): the NVML calls the NVIDIA
# probe makes. A device handle is the C pointer as an int.

import enum

class NvmlError(Exception): ...
class GpuIsLostError(NvmlError): ...
class LibraryNotFoundError(NvmlError): ...
class NoPermissionError(NvmlError): ...
class NotSupportedError(NvmlError): ...
class UnknownError(NvmlError): ...

class ClockType(enum.IntEnum):
    CLOCK_MEM = ...
    CLOCK_SM = ...

class ClocksEventReasons(enum.IntFlag):
    EVENT_REASON_SW_POWER_CAP = ...
    EVENT_REASON_SW_THERMAL_SLOWDOWN = ...
    EVENT_REASON_SYNC_BOOST = ...
    THROTTLE_REASON_HW_POWER_BRAKE_SLOWDOWN = ...
    THROTTLE_REASON_HW_SLOWDOWN = ...
    THROTTLE_REASON_HW_THERMAL_SLOWDOWN = ...

class TemperatureSensors(enum.IntEnum):
    TEMPERATURE_GPU = ...

class Memory_v2:
    free: int
    total: int
    used: int

class PciInfo:
    bus_id: str

class ProcessInfo:
    pid: int
    used_gpu_memory: int

class Utilization:
    gpu: int
    memory: int

def device_get_compute_running_processes_v3(device: int) -> list[ProcessInfo]: ...
def device_get_count_v2() -> int: ...
def device_get_cuda_compute_capability(device: int) -> tuple[int, int]: ...
def device_get_current_clocks_event_reasons(device: int) -> int: ...
def device_get_handle_by_index_v2(index: int) -> int: ...
def device_get_handle_by_pci_bus_id_v2(pci_bus_id: str) -> int: ...
def device_get_handle_by_uuid(uuid: str) -> int: ...
def device_get_max_clock_info(device: int, type: int) -> int: ...
def device_get_memory_bus_width(device: int) -> int: ...
def device_get_memory_info_v2(device: int) -> Memory_v2: ...
def device_get_name(device: int) -> str: ...
def device_get_pci_info_v3(device: int) -> PciInfo: ...
def device_get_power_usage(device: int) -> int: ...
def device_get_temperature_v(device: int, sensorType: int) -> int: ...
def device_get_utilization_rates(device: int) -> Utilization: ...
def device_get_uuid(device: int) -> str: ...
def init_v2() -> None: ...
def system_get_driver_version() -> str: ...
