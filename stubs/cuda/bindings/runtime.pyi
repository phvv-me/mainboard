# Stub for `cuda.bindings.runtime` (cuda-bindings 13.x, no types shipped): the CUDA Runtime calls
# the probe and the profiler make. Every call returns `(error, *values)`, the values meaningful
# only when the error is `cudaError_t.cudaSuccess`.

import enum

class cudaError_t(enum.IntEnum):
    cudaSuccess = ...

class cudaDeviceAttr(enum.IntEnum):
    cudaDevAttrConcurrentManagedAccess = ...
    cudaDevAttrHostNativeAtomicSupported = ...
    cudaDevAttrPageableMemoryAccess = ...

def cudaDeviceGetAttribute(attr: cudaDeviceAttr, device: int) -> tuple[cudaError_t, int]: ...
def cudaDeviceGetPCIBusId(length: int, device: int) -> tuple[cudaError_t, bytes]: ...
def cudaDeviceSynchronize() -> tuple[cudaError_t]: ...
def cudaGetDevice() -> tuple[cudaError_t, int]: ...
def cudaGetDeviceCount() -> tuple[cudaError_t, int]: ...
def cudaMemGetInfo() -> tuple[cudaError_t, int, int]: ...
def cudaRuntimeGetVersion() -> tuple[cudaError_t, int]: ...
def cudaSetDevice(device: int) -> tuple[cudaError_t]: ...
