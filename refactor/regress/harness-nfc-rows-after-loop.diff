     @staticmethod
+    def _census(
+        engine: str, cores: tuple[int, ...], workers: set[tuple[str, int, int, tuple[int, ...]]]
+    ) -> None:
+        """Record the affinity of every thread of this process and its children, once an arm ends."""
+        for process in (psutil.Process(), *psutil.Process().children()):
+            for task in Path(f"/proc/{process.pid}/task").iterdir():
+                try:
+                    mask = tuple(sorted(os.sched_getaffinity(int(task.name))))
+                except ProcessLookupError:
+                    continue
+                assert set(mask) == set(cores), _pinned(process.pid)
+                workers.add((engine, process.pid, int(task.name), mask))
+
+    @staticmethod
     def _upload(texts: list[str]) -> Chunks:
         raw, offsets = HostBatch.from_documents(texts).direct()
         return Chunks.whole(cp.asarray(raw), cp.asarray(offsets), arrays=cp)
