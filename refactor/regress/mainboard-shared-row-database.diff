+@cache
+def _staging() -> Relations:
+    """The one database every row table is staged through, opened on first use.
+
+    A database per row costs the next call: opening and closing one, with no query, made the call
+    after it 0.1 to 0.45 ms slower on the GB10 and an i9, whatever the thread count.
+    """
+    return Relations()
+
+
+def rows_parquet(rows: Sequence[Mapping[str, JsonValue]]) -> bytes:
+    """`rows` as the bytes of one zstd Parquet file, staged through the process's one database."""
+    staging = _staging()
+    relation = staging.rows(rows)
+    try:
+        return parquet_bytes(relation)
+    finally:
+        staging.connection.execute(f"DROP TABLE {relation.alias}")
+
+
 def records(relation: Relation) -> list[dict[str, JsonValue]]:
