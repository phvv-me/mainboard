# Helper function to check exact command path sequence
function __fish_mb_using_command
    set -l cmd (commandline -opc)
    set -l subcommands
    set -l options_with_values '--act --action --against --alias --answer --arch --as --ask --attempt --baseline --batch --budget --cell-timeout --config --configuration --container --count --current --days --derived-data --description --dest --destination --device --directory --dpi --env --every --exclude --expect-info --expect-name --family --fetch --fields --figure --file --for --forbid-resource --forbid-symbol --function --gpu --gpu-name --gpus --handle --host --hours --hue --interval --job --kind --lang --language --library --limit --match --max-bytes --max-rows --max-usd --max-usd-hr --mem-gb --memory --message --name --names --needs --node --nodes --note --on --only --only-testing --operation --os-version --out --package --paper --passes --patch --path --paths --pattern --per-job --pid --pids --port --pricing --profile --project --provider --push --query --question --queue --require-info --results --resume --root --rule --run --scale --scheme --scope --seconds --session --set --setting --show --simulator --since --size --skip --skip-testing --spec --split --sql --stall --style --suite --symbol --tail --target --template --text --timeout --title --to --url-test --usd --walltime --watch --width --x --y -l -m'
    set -l all_commands 'add agents answer app asks binary build cancel check ci code collect commit compact data dedup dep diagram digest doctor evict evidence execute explain find fix fonts gate git grant hold host impact ingest inspect install job keep kill lake launch lint list lock logs materialize matrix memory monitor move new offers pack paper path pending plot preview probe proc proof prose pull push query refactor release remove replicate rules run serve sessions setup shell show simulators sql start status stop submit swift-compare swift-inventory sync test timeout toolchain tree trial update upgrade usage uses wait'
    set -l skip_next 0
    # Extract command words (only real subcommand names) from command line
    for i in (seq 2 (count $cmd))
        set -l word $cmd[$i]
        if test $skip_next -eq 1
            set skip_next 0
            continue
        end
        if string match -qr -- '^-' $word
            # Check if this option takes a value (exact match)
            if string match -q -- "* $word *" " $options_with_values "
                set skip_next 1
            end
        else
            # Only add to subcommands if word is a registered command name
            if string match -q -- "* $word *" " $all_commands "
                set -a subcommands $word
            end
        end
    end
    # Check if subcommand sequence matches expected path
    if test (count $subcommands) -ne (count $argv)
        return 1
    end
    for i in (seq 1 (count $argv))
        if test $subcommands[$i] != $argv[$i]
            return 1
        end
    end
    return 0
end

# Helper: print the index of the next positional slot for the active command path.
function __fish_mb_positional_index
    set -l cmd (commandline -opc)
    set -l path_len $argv[1]
    set -l options_with_values '--act --action --against --alias --answer --arch --as --ask --attempt --baseline --batch --budget --cell-timeout --config --configuration --container --count --current --days --derived-data --description --dest --destination --device --directory --dpi --env --every --exclude --expect-info --expect-name --family --fetch --fields --figure --file --for --forbid-resource --forbid-symbol --function --gpu --gpu-name --gpus --handle --host --hours --hue --interval --job --kind --lang --language --library --limit --match --max-bytes --max-rows --max-usd --max-usd-hr --mem-gb --memory --message --name --names --needs --node --nodes --note --on --only --only-testing --operation --os-version --out --package --paper --passes --patch --path --paths --pattern --per-job --pid --pids --port --pricing --profile --project --provider --push --query --question --queue --require-info --results --resume --root --rule --run --scale --scheme --scope --seconds --session --set --setting --show --simulator --since --size --skip --skip-testing --spec --split --sql --stall --style --suite --symbol --tail --target --template --text --timeout --title --to --url-test --usd --walltime --watch --width --x --y -l -m'
    set -l skip_next 0
    set -l consumed_path 0
    set -l count 0
    for i in (seq 2 (count $cmd))
        set -l word $cmd[$i]
        if test $skip_next -eq 1
            set skip_next 0
            continue
        end
        if string match -qr -- '^-' $word
            if string match -q -- "* $word *" " $options_with_values "
                set skip_next 1
            end
        else
            if test $consumed_path -lt $path_len
                set consumed_path (math $consumed_path + 1)
            else
                set count (math $count + 1)
            end
        end
    end
    echo $count
end

