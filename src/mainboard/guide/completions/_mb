#compdef mb

_cyclopts_mb() {
  local line state

  _arguments -C \
    '1: :->cmds' \
    '*::arg:->args'

  case $state in
    cmds)
      local -a commands
      commands=(
        'run:Run a command or a file\:\:job through the host'\''s plan.'
        'dep:Declare, solve and install environments; pixi'\''s verbs mean what pixi'\''s mean.'
        'job:Dispatch jobs to hosts and follow them until they settle.'
        'host:Set up, list, inspect and reach the machines jobs run on.'
        'proc:Kill a process tree, bound a command, wait for a file or port, on every system.'
        'code:Check, fix and move the code; build its apps and its agents'\'' configuration.'
        'git:Operate the workspace repository and its owned submodules as one tree.'
        'data:Query, keep and publish the workspace'\''s evidence\: results, lake, papers.'
        'memory:Find and keep what AIZK remembers; a keep made while it is down waits.'
        'serve:Start every service; one supervisor this machine keeps alive runs them.'
      )
      _describe -t commands 'command' commands
      ;;
    args)
      case $words[1] in
        run)
          _arguments \
            '*:the command tokens, from the first token that is not an option of this verb, pa…' \
            '*--on[the host alias, local for this machine.]:on' \
            '*--env[an environment name overriding the profile'\''s choice.]:env' \
            '*--container[a container override, none forcing bare.]:container' \
            '--locked[refuse a lock that no longer answers the manifest.]' \
            '--frozen[take the lock as it stands, never comparing it with the manifest.]' \
            '--no-install[leave the environment as it is installed.]' \
            '--as-is[--frozen and --no-install together\: run what is installed, as it is.]'

          ;;
        dep)
          _arguments -C \
            '1: :->cmds' \
            '*::arg:->args'

          case $state in
            cmds)
              local -a commands
              commands=(
                'install:Install an environment, solving the lock first when it no longer answers the ma…'
                'add:Declare a dependency in the manifest, re-lock and install, as pixi add does.'
                'remove:Drop a dependency from the manifest, re-lock and install, as pixi remove does.'
                'update:Move the lock to the newest releases the manifest allows, as pixi update does.'
                'upgrade:Raise requirements to their newest releases, re-lock and install, as pixi upgra…'
                'lock:Solve the lock where it no longer answers the manifest, installing nothing.'
                'list:List the packages installed in an environment, through pixi list.'
                'tree:Show an environment'\''s dependency tree, through pixi tree.'
                'shell:Open an interactive shell in this workspace'\''s environment, here or on a host.'
                'binary:Install and find the executables a manifest pins by release archive and hash.'
              )
              _describe -t commands 'command' commands
              ;;
            args)
              case $words[1] in
                install)
                  _arguments \
                    '1:the environment name, this machine'\''s declared profile choice when omitted.' \
                    '*--env[the environment name, this machine'\''s declared profile choice when omitted.]:env' \
                    '--all[install every declared environment.]' \
                    '-a[install every declared environment.]' \
                    '--locked[refuse a lock that no longer answers the manifest.]' \
                    '--frozen[take the lock as it stands, never comparing it with the manifest.]' \
                    '*--profile[the declared host profile describing this machine, so the environment'\''s activat…]:profile'

                  ;;
                add)
                  _arguments \
                    '1:--spec' \
                    '*--spec[--spec]:spec' \
                    '*--lang[only this ecosystem'\''s tables (python, conda, nodejs, ...); a new requirement is…]:lang' \
                    '*-l[only this ecosystem'\''s tables (python, conda, nodejs, ...); a new requirement is…]:l' \
                    '*--env[only this environment'\''s tables, the workspace-wide ones when empty.]:env' \
                    '--dev[only the development-only tables.]' \
                    '--no-install[re-lock without installing.]' \
                    '--frozen[edit the manifest alone, leaving the lock as it stands, to solve several edits …]' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                remove)
                  _arguments \
                    '1:the dependency to drop.' \
                    '*--name[the dependency to drop.]:name' \
                    '*--lang[only this ecosystem'\''s tables (python, conda, nodejs, ...); a new requirement is…]:lang' \
                    '*-l[only this ecosystem'\''s tables (python, conda, nodejs, ...); a new requirement is…]:l' \
                    '*--env[only this environment'\''s tables, the workspace-wide ones when empty.]:env' \
                    '--dev[only the development-only tables.]' \
                    '--no-install[re-lock without installing.]' \
                    '--frozen[edit the manifest alone, leaving the lock as it stands, to solve several edits …]' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                update)
                  _arguments \
                    '*:the packages to move, every one when none is named.' \
                    '*--env[only this environment'\''s lock.]:env' \
                    '--no-install[re-lock without installing.]' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

