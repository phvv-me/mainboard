                    '*--fields[a comma-separated projection over the printed fields.]:fields' \
                    '1: :->cmds' \
                    '*::arg:->args'

                  case $state in
                    cmds)
                      local -a commands
                      commands=(
                        'list:Judge each pinned binary tool\: the version found and where, or what is wrong.'
