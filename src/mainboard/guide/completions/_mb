                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                setup)
                  _arguments \
                    '1:--host' \
                    '*--host[--host]:host' \
                    '*--env[an environment name overriding the host profile'\''s own.]:env' \
                    '--resolve[let the host solve for itself (install there) instead of installing the shipped…]' \
