                lock)
                  _arguments \
                    '1:the environment to lock, every declared one when omitted.' \
                    '*--env[the environment to lock, every declared one when omitted.]:env' \
                    '--check[exit nonzero when the lock had to change, the gate for a commit or CI.]'

                  ;;
                list)
                  _arguments \
                    '*:pixi'\''s own arguments, a package regex first (mb dep list torch --json).' \
                    '*--env[the environment name.]:env'

                  ;;
                tree)
                  _arguments \
                    '*:pixi'\''s own arguments, a package regex first (mb dep tree numpy --invert).' \
                    '*--env[the environment name.]:env'

                  ;;
                shell)
                  _arguments \
                    '*:on a host, a command to run instead of handing over the terminal, from the firs…' \
                    '*--on[the host alias, local for this machine.]:on' \
                    '*--env[the environment name, the profile'\''s declared choice when omitted.]:env' \
                    '*--queue[on a queued host, the queue the allocation targets, the profile'\''s when omitted.]:queue' \
                    '*--walltime[on a queued host, the session'\''s wall-clock limit, the profile'\''s when omitted.]:walltime' \
                    '*--nodes[on a queued host, how many compute nodes the allocation spans; a held session o…]:nodes' \
                    '--keep[on a host, hold the session in tmux on the far side so a dropped terminal leave…]' \
                    '--locked[refuse a lock that no longer answers the manifest.]' \
                    '--frozen[take the lock as it stands, never comparing it with the manifest.]' \
                    '--no-install[leave the environment as it is installed.]' \
                    '--as-is[--frozen and --no-install together\: run what is installed, as it is.]'

