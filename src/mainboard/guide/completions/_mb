                      ;;
                  esac
                  ;;
              esac
              ;;
          esac
          ;;
        job)
          _arguments -C \
            '1: :->cmds' \
            '*::arg:->args'

          case $state in
            cmds)
              local -a commands
              commands=(
                'submit:Dispatch one job, a batch, or a test lane split over hosts, and print the handl…'
                'list:Settle every job that ended, then list the live ones and the newest settled one…'
                'show:Refresh one job or batch, print its recorded outcome, and exit with it.'
                'logs:Print only what a dispatched job printed, whether or not its host still exists.'
                'cancel:Stop a dispatched job on whatever took it and settle its record in the same pas…'
                'digest:Fold one experiment'\''s runs\: counts by state, each failure with its log tail, li…'
                'monitor:Start, stop and inspect the periodic pass that settles jobs unattended.'
              )
              _describe -t commands 'command' commands
              ;;
            args)
              case $words[1] in
                submit)
                  _arguments \
                    '*:the command tokens, from the first token that is not an option of this verb, or…' \
                    '*--on[the host alias; comma-separated for a lane.]:on' \
                    '*--resume[a failed or cancelled run to continue, by handle or name, as its next attempt.]:resume' \
                    '*--name[the run'\''s label, or the batch'\''s name for a --job batch.]:name' \
                    '*--attempt[the 1-based try number feeding expression defaults.]:attempt' \
                    '*--split[a lane'\''s parametrize name; each of its values becomes one job.]:split' \
                    '*--per-job[a lane'\''s cells per job when no name groups them, 0 for all in one.]:per-job' \
                    '*--cell-timeout[seconds one lane cell may take before its process is killed.]:cell-timeout' \
                    '--estimate[price the plan and print it; dispatch nothing.]' \
                    '--wait[block until every submitted job settles; exit 0 clean, 1 failed, 2 timeout.]' \
                    '--yes[dispatch without asking, what a script passes.]' \
                    '*--queue[a queued host'\''s queue, the profile'\''s default when empty.]:queue' \
                    '*--walltime[the wall-clock limit, HH\:MM\:SS, the profile'\''s default when empty.]:walltime' \
                    '*--mem-gb[system memory to ask the scheduler for, the profile'\''s default when 0.]:mem-gb' \
                    '*--gpus[cards per job, the profile'\''s default when 0.]:gpus' \
                    '*--gpu-name[the GPU type to rent, for a metered provider host.]:gpu-name' \
                    '*--arch[rent the cheapest card of these compute capabilities (sm_120, sm_90+, hopper) i…]:arch' \
                    '*--max-usd[the spend cap a provider host refuses to submit without.]:max-usd' \
                    '--spot[rent interruptible capacity; a job taken back reads vanished, and --resume <nam…]' \
                    '--datacenter[rent only from data-center hosts, for a provider that also lists individually r…]' \
                    '*--fetch[a results path recorded for later collection, the node'\''s evidence directory whe…]:fetch' \
                    '*--node[the ledger slug this run serves, carried into its record and receipts.]:node' \
                    '*--needs[a workspace-relative data path the job reads on the host, repeatable.]:needs' \
                    '*--env[the environment the job enters, the host profile'\''s own when empty.]:env' \
                    '*--container[a container override, none forcing bare.]:container' \
                    '*--batch[a batch spec file, relative to the workspace root.]:batch' \
                    '*--job[a target\:command job, repeatable, for a batch declared without a file.]:job' \
                    '*--only[the plan'\''s jobs to act on, names or kind-* globs, comma-separated; all when uns…]:only' \
                    '*--set[a name=value filling one of the spec file'\''s \[vars\], repeatable.]:set' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                list)
                  _arguments \
                    '*--limit[how many settled runs to show behind the live ones, newest first.]:limit' \
                    '*--project[only the runs dispatched from this project (its directory under research/ or pa…]:project' \
                    '*--batch[one batch'\''s jobs instead, as submit --batch printed its id.]:batch' \
                    '*--watch[repeat every this many seconds until interrupted.]:watch' \
                    '*--every[install the settling pass into this machine'\''s service manager at this period (2…]:every' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                show)
                  _arguments \
                    '1:a handle or name as submit/list print it, a batch id, a receipts stream id, dir…' \
                    '*--target[a handle or name as submit/list print it, a batch id, a receipts stream id, dir…]:target' \
                    '*--on[the host alias narrowing a handle recorded on several hosts.]:on' \
                    '*--run[which run of a receipts store to score, its newest when unset.]:run' \
                    '*--timeout[with --wait, give up after this many seconds (exit 2); 0 waits forever.]:timeout' \
                    '*--stall[with --wait, seconds a running job may print nothing on an idle card before the…]:stall' \
                    '--wait[block until the target settles.]' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                logs)
                  _arguments \
                    '1:the job to read, as submit printed it or by the name jobs prints.' \
                    '*--handle[the job to read, as submit printed it or by the name jobs prints.]:handle' \
                    '*--on[the host alias narrowing a handle recorded on several hosts.]:on'

                  ;;
                cancel)
                  _arguments \
                    '1:the job to cancel, as submit printed it or by the name jobs prints.' \
                    '*--handle[the job to cancel, as submit printed it or by the name jobs prints.]:handle' \
                    '*--on[the host alias narrowing a handle recorded on several hosts.]:on' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                digest)
                  _arguments \
                    '*--node[the ledger slug the runs serve (a batch spec'\''s node); every run when empty.]:node' \
                    '*--project[only the runs dispatched from this project.]:project' \
                    '*--limit[how many settled runs to read behind the live ones.]:limit' \
                    '*--tail[how many closing lines of each failed run'\''s log to print.]:tail' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

                  ;;
                monitor)
                  _arguments -C \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields' \
                    '1: :->cmds' \
                    '*::arg:->args'

                  case $state in
                    cmds)
                      local -a commands
                      commands=(
                        'start:Arm the installed settling pass again after stop; one already armed is left alo…'
                        'status:Say whether the settling pass is installed and armed, when it last ran, and the…'
                        'stop:Unload the settling pass but keep it installed, so no pass runs until start.'
                      )
                      _describe -t commands 'command' commands
                      ;;
                    args)
                      case $words[1] in
                        start)
                          ;;
                        status)
                          ;;
                        stop)
                          ;;
                      esac
                      ;;
                  esac
                  ;;
              esac
              ;;
          esac
          ;;
        host)
          _arguments -C \
            '1: :->cmds' \
            '*::arg:->args'

          case $state in
            cmds)
              local -a commands
              commands=(
                'list:List every compute path this workspace can reach; flags add detail per host.'
                'setup:Onboard a host until it can run jobs, then show what it became and what that me…'
                'sync:Re-mirror a host already set up and re-provision it from the shipped lock.'
                'evict:Remove a host'\''s copies of evidence the center'\''s lake holds, to give its disk ba…'
                'update:Reinstall this tool from its source when the source moved, as uv self update do…'
                'upgrade:Bring this machine or a host up to date in one pass, printing each step as it r…'
                'pack:Build an environment into files a machine runs without installing anything.'
                'offers:Every cloud'\''s GPU offers, best useful hour first, and whether this tool can ren…'
                'hold:Rent a machine and keep it as an ssh host until a deadline, set up and ready fo…'
                'release:End a held machine now\: stop its billing, settle its record and drop its alias.'
              )
              _describe -t commands 'command' commands
              ;;
            args)
              case $words[1] in
                list)
                  _arguments \
                    '*:narrow the listing to these aliases, local for this machine.' \
                    '--facts[each host'\''s probed hardware and software, then what they mean for this workspac…]' \
                    '--gpus[who holds each card now\: utilization, memory and the processes on it.]' \
                    '--audit[what each host could and should update, read-only; host upgrade applies it. Exi…]' \
