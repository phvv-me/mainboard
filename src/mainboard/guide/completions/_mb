                    '*--env[only this environment'\''s tables, the workspace-wide ones when empty.]:env' \
                    '--dev[only the development-only tables.]' \
                    '--no-install[re-lock without installing.]' \
                    '--frozen[edit the manifest alone, leaving the lock as it stands, to solve several edits …]' \
                    '*--exclude[a requirement to leave as written when raising every one, repeatable.]:exclude' \
                    '--json[print canonical JSON instead of the compact rows.]' \
                    '*--fields[a comma-separated projection over the printed fields.]:fields'

