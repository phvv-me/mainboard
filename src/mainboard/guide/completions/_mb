                    args)
                      case $words[1] in
                        list)
                          _arguments \
                            '*--env[the environment whose tool directory is read.]:env' \
                            '--json[print canonical JSON instead of the compact rows.]' \
                            '*--fields[a comma-separated projection over the printed fields.]:fields'

                          ;;
                        path)
                          _arguments \
                            '1:the executable, pinned in the manifest or shipped by conda-forge.' \
