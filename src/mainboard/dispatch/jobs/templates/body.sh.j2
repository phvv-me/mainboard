{% set pbs = pbs | default(false) %}
# Finalize completed receipts on normal exit and graceful termination. SIGKILL cannot run a
# trap; this is not incremental transport. Cleanup must retain the command's original status.
unset MAINBOARD_RECEIPTS
mainboard_exit() {
  local status="$1"
  trap - EXIT
  set +e
  if [ -n "${MAINBOARD_RECEIPTS:-}" ]; then
    {{ receipts_framing }}
  fi
{% if pbs %}
  printf 'exit=%s\n' "$status" >> "$mainboard_log"
  printf 'exit=%s\n' "$status" > "{{ state_dir }}/logs/${PBS_JOBID%%.*}.exit"
{% endif %}
  exit "$status"
}
trap 'mainboard_exit $?' EXIT
trap 'exit 143' TERM
{% if provide %}
# Build the environment this job activates, unless the host already has it. It is addressed by
# the content of the manifest and lock this job was dispatched with, so this is a stat on every
# job but the one that builds it, and a wave whose prefix was pruned or interrupted rebuilds
# exactly the one it was dispatched against rather than whatever the workspace holds now. Its
# failure is not this job's failure: the activation below still refuses, in words that name it.
{{ provide }} || echo "mainboard: could not build the environment this job was dispatched with"
{% endif %}
{{ activation }}
{% if pythonpath %}
# The import roots of the tree this job was pinned to, ahead of everything the environment adds
# and instead of anything the submitting shell exported. A prefix is shared by every tree whose
# manifest and lock agree, so the editable install inside it points at the mirror, and a sync
# between two waves would otherwise move this job's own source while it runs.
export PYTHONPATH={{ pythonpath }}
{% elif isolate_pythonpath %}
# A dispatched job imports from its own environment only, so a PYTHONPATH the submitting shell
# happened to export is dropped here on purpose rather than inherited without anyone deciding.
unset PYTHONPATH
{% endif %}
{% if source %}
# The captured source identity, computed from paths and bytes without version control.
export MAINBOARD_SOURCE={{ source }}
{% endif %}
{% if commit %}
# Optional historical revision metadata; never an admission condition.
export MAINBOARD_SOURCE_COMMIT={{ commit }}
{% endif %}
{% if digest %}
# The SHA-256 of the captured source listing. Preflight verifies the actual file bytes.
export MAINBOARD_SOURCE_DIGEST={{ digest }}
{% endif %}
{% if closure %}
# What this job ships, one `path blob status` row per file, so a receipt can list what it ran on
# and the runner can refuse a first-party import the closure never named.
export MAINBOARD_CLOSURE={{ closure }}
{% endif %}
{% if first_party %}
# The names the workspace's own import roots define, shipped or not: the runner answers an
# import of one of these from the closure alone, never from the mirror an editable install names.
export MAINBOARD_FIRST_PARTY={{ first_party }}
{% endif %}
{% if deferred %}
# Names whose whole distribution the closure left to the environment because a compiled
# extension of theirs resolves outside the tree: the runner admits every import of these rather
# than refusing one the listing was never going to carry.
export MAINBOARD_DEFERRED={{ deferred }}
{% endif %}
{% for key, value in exports %}
export {{ key }}={{ value }}
{% endfor %}
{% if attestation %}
# What this machine looked like the instant before the command started, recorded into the job's
# own receipts. It runs in the foreground and before the work, which is the only way the reading
# describes the conditions the measurement was actually taken under.
{{ attestation }}
{% endif %}
{% if sampler %}
# This host watches itself while the job runs, publishing into the job's own receipts. It is
# backgrounded, its output goes nowhere so it can never land in the captured log, and it ends
# with this script rather than outliving it.
{{ sampler }}
{% endif %}
# A trial writes its receipts to this file rather than printing them, so a line long enough to be
# cut, interleaved with another job's output, or swallowed by a torn log still arrives whole. The
# command's own status is kept and re-raised below, so framing the receipts back afterwards costs
# the job none of its exit code.
{{ receipts_staging }}
# The command runs from the tree this dispatch pinned and verified, whatever an earlier stage
# changed into: a relative path in the job then names frozen code, never the mirror's.
cd {{ root }}
status=0
{% if container_command %}
{{ container_command }} || status=$?
{% else %}
bash -c {{ cmd }} || status=$?
{% endif %}
exit $status
