#!/bin/bash
#PBS -q {{ queue }}
#PBS -l {{ chunk }}
#PBS -l walltime={{ walltime }}
{% if account %}
#PBS -W group_list={{ account }}
{% endif %}
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p {{ state_dir }}/logs
# The shared exit handler finalizes receipts and records status after graceful termination,
# including when the PBS server later purges the job from qstat/history.
mainboard_log="{{ state_dir }}/logs/${PBS_JOBID%%.*}.log"
exec >> "$mainboard_log" 2>&1
{% set pbs = true %}
{% include "body.sh.j2" %}
