#!/usr/bin/env bash
# Generated by mainboard's Provisioner.activate() — source it to set up the whole
# environment (HPC modules + pixi env), then run `python -m ...`.
# Regenerate by calling `activate()` again; do not edit by hand.

# Module inits and conda activation scripts are not nounset-safe, so relax `set -u`
# while activating and restore it afterwards for callers that run under it.
case $- in *u*) _mainboard_nounset=1; set +u;; *) _mainboard_nounset=0;; esac

{% if modules %}
# HPC modules (guarded so it no-ops off a cluster).
{{ module_init }}
if command -v module >/dev/null 2>&1; then
  module purge
  module load {{ modules }}
fi

{% endif %}
# pixi env activation (env vars, PATH, activation scripts).
{{ hook }}
{% if binaries %}

# Executables the second-stage toolchains linked (npm's `node_modules/.bin`, a Go `GOBIN`),
# ahead of the env's own `bin/` exactly as `Provisioner.activated()` orders them.
export PATH={{ binaries }}:"$PATH"
{% endif %}

# `if` rather than `&&` so a false test cannot trip a caller running under `set -e`.
if [ "${_mainboard_nounset}" = 1 ]; then set -u; fi
unset _mainboard_nounset
